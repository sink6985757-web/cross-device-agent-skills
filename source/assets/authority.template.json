{
  "schema_version": 1,
  "policy": "PROTECTED files require authority-unlock --yes, then authority-seal --yes; signature and hashes are mandatory, OS read-only is applied when supported",
  "protected": [
    {"path": "SOURCE.md", "kind": "file", "writer": "formal-change-only", "reason": "single human and agent entry contract", "sha256": null},
    {"path": "AGENTS.md", "kind": "file", "writer": "formal-change-only", "reason": "cross-agent authority pointer", "sha256": null},
    {"path": ".source/config.json", "kind": "file", "writer": "formal-change-only", "reason": "root-relative canonical configuration", "sha256": null},
    {"path": "source.ps1", "kind": "file", "writer": "formal-change-only", "reason": "Windows adapter", "sha256": null},
    {"path": "source.sh", "kind": "file", "writer": "formal-change-only", "reason": "Linux and macOS adapter", "sha256": null},
    {"path": ".gitattributes", "kind": "file", "writer": "formal-change-only", "reason": "cross-platform text contract", "sha256": null},
    {"path": ".gitignore", "kind": "file", "writer": "formal-change-only", "reason": "secret and runtime exclusion contract", "sha256": null}
  ],
  "generated": [
    {"path": ".source/state.json", "writer": "source-engine-only", "reason": "resumable checkpoint; never hand edit"},
    {"path": "handoff.md", "writer": "source-engine-only", "reason": "human-readable projection of state"},
    {"path": ".source/runtime/", "writer": "source-engine-only", "reason": "device-local formal-change marker; never commit"},
    {"path": ".source/coordination/", "writer": "source-engine-only", "reason": "cloud-synced leases; never commit or hand edit"},
    {"path": ".source/hub/", "writer": "source-engine-only", "reason": "append-only child descriptors, events, and skill proposals"},
    {"path": "logs/sessions/", "writer": "source-engine-only", "reason": "project-local resumable session logs"}
  ],
  "external_read_only": [
    {"config_pointer": "connectors.notion.prompt", "writer": "never", "reason": "Notion Prompt is read-only"}
  ],
  "sealed_at": null,
  "sealed_by": null
}
